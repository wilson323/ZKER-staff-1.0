{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zker:design:collaboration-extension:v2.1",
  "title": "ZKER collaboration extension design candidate",
  "$comment": "Design candidate only. Structural validation is not authorization, cross-record integrity, runtime loading, or implementation evidence.",
  "x-design-status": "PROPOSED_NOT_IMPLEMENTED",
  "oneOf": [
    {
      "$ref": "#/$defs/CollaborationLink"
    },
    {
      "$ref": "#/$defs/Contribution"
    },
    {
      "$ref": "#/$defs/ExecutionContextBinding"
    },
    {
      "$ref": "#/$defs/ContextApplication"
    },
    {
      "$ref": "#/$defs/ContextManifestV2"
    }
  ],
  "$defs": {
    "VersionedRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "required": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "ref",
        "version",
        "digest",
        "required",
        "purpose"
      ]
    },
    "CollaborationLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collaborationLinkId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "parentWorkItemId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "childWorkItemId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "collaborationRequestRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expectedOutputSchemaRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "baselineWorkItemRevision": {
          "type": "integer",
          "minimum": 1
        },
        "requiredForParent": {
          "type": "boolean"
        },
        "delegationRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "dueAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "accepted",
            "active",
            "delivered",
            "closed",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "createdByMembershipId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "collaborationLinkId",
        "tenantId",
        "parentWorkItemId",
        "childWorkItemId",
        "collaborationRequestRef",
        "objective",
        "expectedOutputSchemaRef",
        "baselineWorkItemRevision",
        "requiredForParent",
        "status",
        "revision",
        "createdByMembershipId",
        "createdAt"
      ]
    },
    "Contribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contributionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "collaborationLinkId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "childWorkItemId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "contributionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "basedOnContextBindingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "basedOnParentRevision": {
          "type": "integer",
          "minimum": 1
        },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/VersionedRef"
          }
        },
        "structuredResultRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "resultDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "completionCheckResultId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": {
          "enum": [
            "draft",
            "submitted",
            "accepted",
            "returned",
            "needs_recheck",
            "superseded",
            "withdrawn"
          ]
        },
        "submittedByMembershipId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decisionByMembershipId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decisionAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "contributionId",
        "tenantId",
        "collaborationLinkId",
        "childWorkItemId",
        "contributionVersion",
        "basedOnContextBindingId",
        "basedOnParentRevision",
        "artifactRefs",
        "structuredResultRef",
        "resultDigest",
        "status",
        "revision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "submitted",
                  "accepted",
                  "returned",
                  "needs_recheck",
                  "superseded"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "completionCheckResultId",
              "submittedByMembershipId",
              "submittedAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "returned",
                  "superseded",
                  "withdrawn"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "decisionByMembershipId",
              "decisionAt",
              "reason"
            ]
          }
        }
      ]
    },
    "ExecutionContextBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contextBindingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workItemId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workItemRevision": {
          "type": "integer",
          "minimum": 1
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "executionSnapshotId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "contextManifestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "contextManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "baseThreadSequence": {
          "type": "integer",
          "minimum": 0
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedRef"
          }
        },
        "sourceRefsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "requiredFactKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "uniqueItems": true
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "authzEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "pluginProfileDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "contextBindingId",
        "tenantId",
        "workItemId",
        "workItemRevision",
        "assignmentId",
        "attemptId",
        "executionSnapshotId",
        "contextManifestId",
        "contextManifestDigest",
        "baseThreadSequence",
        "sourceRefs",
        "sourceRefsDigest",
        "inputDigest",
        "requiredFactKeys",
        "policyRevision",
        "authzEpoch",
        "expiresAt",
        "bindingDigest",
        "createdAt"
      ]
    },
    "ContextApplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "contextBindingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "consumerSubjectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "state": {
          "enum": [
            "prepared",
            "delivered",
            "loaded",
            "update_required",
            "blocked",
            "revoked"
          ]
        },
        "deliveredAt": {
          "type": "string",
          "format": "date-time"
        },
        "loadedAt": {
          "type": "string",
          "format": "date-time"
        },
        "appliedSequence": {
          "type": "integer",
          "minimum": 0
        },
        "observedSequence": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "blockedReasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "applicationId",
        "tenantId",
        "contextBindingId",
        "attemptId",
        "consumerSubjectId",
        "state",
        "appliedSequence",
        "observedSequence",
        "evidenceRefs",
        "revision",
        "updatedAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "delivered",
                  "loaded"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "deliveredAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "loaded"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "loadedAt"
            ],
            "properties": {
              "evidenceRefs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "blocked",
                  "revoked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "blockedReasonCode"
            ]
          }
        }
      ]
    },
    "ContextManifestV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "staffdeck.context-manifest/v2"
        },
        "contextManifestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sourceWorkItemId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "targetScope": {
          "enum": [
            "NODE_HANDOFF",
            "WORK_ITEM"
          ]
        },
        "targetNodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "targetWorkItemId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "targetSubjectType": {
          "enum": [
            "HUMAN",
            "AGENT",
            "ROLE",
            "UNRESOLVED"
          ]
        },
        "targetSubjectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sourceRefsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fieldProjectionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authzEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schemaVersion",
        "contextManifestId",
        "tenantId",
        "sourceWorkItemId",
        "targetScope",
        "targetSubjectType",
        "purpose",
        "sourceRefsDigest",
        "fieldProjectionDigest",
        "authzEpoch",
        "policyRevision",
        "expiresAt",
        "createdAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "targetScope": {
                "const": "NODE_HANDOFF"
              }
            },
            "required": [
              "targetScope"
            ]
          },
          "then": {
            "required": [
              "targetNodeId"
            ],
            "not": {
              "required": [
                "targetWorkItemId"
              ]
            }
          },
          "else": {
            "required": [
              "targetWorkItemId"
            ],
            "not": {
              "required": [
                "targetNodeId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "targetSubjectType": {
                "enum": [
                  "AGENT",
                  "HUMAN"
                ]
              }
            },
            "required": [
              "targetSubjectType"
            ]
          },
          "then": {
            "required": [
              "targetSubjectId"
            ]
          }
        }
      ]
    }
  },
