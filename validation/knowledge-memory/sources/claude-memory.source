x_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></div></div><div data-orientation="horizontal" data-activation-direction="none" id="base-ui-_R_38j6aav5ul5tpfibrad4plb_" role="tabpanel" tabindex="-1" data-index="-1" class="cds-reset outline-none focus-visible:outline-hidden data-[ending-style]:hidden"><div class="h-full py-4 pl-4 text-code overflow-x-auto" tabindex="0"><div class="inline-block min-w-full pr-4" data-code-source="" translate="no"><pre class="shiki shiki-themes github-light-default dark-plus" style="--shiki-light:#1f2328;--shiki-dark:#f3f7f6;--shiki-light-bg:transparent;--shiki-dark-bg:transparent"><code><span class="line"><span style="--shiki-light:#953800;--shiki-dark:#DCDCAA">ant</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178"> beta:memory-stores:memories</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178"> list</span><span style="--shiki-light:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="--shiki-light:#0550AE;--shiki-dark:#569CD6">  --memory-store-id</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178"> "</span><span style="--shiki-light:#1F2328;--shiki-dark:#9CDCFE">$store_id</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178">"</span><span style="--shiki-light:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
