\"\u003e  --data\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e @-\u003c/span\u003e\u003cspan style=\"--shiki-light:#CF222E;--shiki-dark:#f3f7f6\"\u003e \u0026#x3C;\u0026#x3C;\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003eEOF\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e  \"agent\": \"\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#9CDCFE\"\u003e$agent_id\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e\",\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e  \"environment_id\": \"\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#9CDCFE\"\u003e$environment_id\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e\",\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e  \"resources\": [\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e    {\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e      \"type\": \"memory_store\",\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e      \"memory_store_id\": \"\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#9CDCFE\"\u003e$store_id\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e\",\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e      \"access\": \"read_write\",\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e      \"instructions\": \"User preferences and project context. Check before starting any task.\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e    }\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e  ]\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e}\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003eEOF\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3e:[\"$\",\"$L84\",\"39\",{\"defaultLanguage\":\"CLI\",\"children\":[[\"$\",\"$L85\",\"0\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"cURL\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$99\"}}]}],\"$L9a\",\"$L9b\",\"$L9c\",\"$L9d\",\"$L9e\",\"$L9f\",\"$La0\",\"$La1\"]}]\n3f:[\"$\",\"$L2c\",\"41\",{\"variant\":\"warning\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block [.prose_\u0026]:text-prose\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Memory stores attach with \",[\"$\",\"code\",\"1\",{\"children\":[\"read_write\"]}],\" access by default. If the agent processes untrusted input (user-supplied prompts, fetched web content, or third-party tool output), a successful prompt injection could write malicious content into the store. Later sessions then read that content as trusted memory. Use \",[\"$\",\"code\",\"3\",{\"children\":[\"read_only\"]}],\" for reference material, shared lookups, and any store the agent does not need to modify.\"]}]]}]\n40:[\"$\",\"p\",\"43\",{\"children\":[\"A maximum of \",[\"$\",\"strong\",\"1\",{\"children\":[\"8 memory stores\"]}],\" are supported per session. Attach multiple stores when different parts of memory have different owners or access rules. Common reasons:\"]}]\n41:[\"$\",\"ul\",\"45\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Shared reference material:\"]}],\" one read-only store attached to many sessions (standards, conventions, domain knowledge), kept separate from each session's own read-write store.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Mapping to your product's structure:\"]}],\" one store per end user, per team, or per project, while sharing a single agent configuration.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Different lifecycles:\"]}],\" a store that outlives any single session, or one you want to archive on its own schedule.\"]}],\"\\n\"]}]\n42:[\"$\",\"$L2e\",\"47\",{\"level\":3,\"slug\":\"how-the-agent-accesses-memory\",\"children\":[\"How the agent accesses memory\"]}]\n43:[\"$\",\"p\",\"49\",{\"children\":[\"Each attached store is mounted inside the session's sandbox as a directory under \",[\"$\",\"code\",\"1\",{\"children\":[\"/mnt/memory/\"]}],\". The directory name is the store's display name sanitized to a filesystem-safe slug (lowercased; non-alphanumeric runs become a single hyphen), so a store named \\\"Demo Memory\\\" mounts at \",[\"$\",\"code\",\"3\",{\"children\":[\"/mnt/memory/demo-memory/\"]}],\". The exact path is returned in the \",[\"$\",\"code\",\"5\",{\"children\":[\"mount_path\"]}],\" field on the session's memory-store resource; read it from there rather than constructing it yourself. The agent reads and writes the store with the standard \",[\"$\",\"$L2d\",\"7\",{\"href\":\"/docs/en/managed-agents/tools\",\"children\":[\"agent toolset\"]}],\". Writes under the mount path are persisted back to the store and stay in sync across sessions that share it; writes to any other path under \",[\"$\",\"code\",\"9\",{\"children\":[\"/mnt/memory/\"]}],\" fail, because the sandbox mounts that parent directory read-only. A short description of each mount (display name, mount path, access mode, store \",[\"$\",\"code\",\"11\",{\"children\":[\"description\"]}],\", and any \",[\"$\",\"code\",\"13\",{\"children\":[\"instructions\"]}],\") is automatically added to the system prompt.\"]}]\n44:[\"$\",\"p\",\"51\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"access\"]}],\" is enforced at the filesystem level: a \",[\"$\",\"code\",\"2\",{\"children\":[\"read_only\"]}],\" mount rejects writes, while writes to a \",[\"$\",\"code\",\"4\",{\"children\":[\"read_write\"]}],\" mount produce \",[\"$\",\"$L2d\",\"6\",{\"href\":\"#audit-memory-changes\",\"children\":[\"memory versions\"]}],\" attributed to the session.\"]}]\n45:[\"$\",\"$L2c\",\"53\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block [.prose_\u0026]:text-prose\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"On \",[\"$\",\"$L2d\",\"1\",{\"href\":\"/docs/en/managed-agents/self-hosted-sandboxes#use-memory-stores\",\"children\":[\"self-hosted sandboxes\"]}],\", each store's directory is a local copy that the SDK worker manages rather than a live mount. The worker reconciles each copy with its store after tool calls, at most once per sync interval (15 seconds by default), and once more when the session ends. The agent's \",[\"$\",\"code\",\"3\",{\"children\":[\"write\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"edit\"]}],\" tools change only the local copy; the worker uploads those changes at its next sync, so another session running on a self-hosted sandbox sees a change only after both workers have synced. Paths under \",[\"$\",\"code\",\"7\",{\"children\":[\"/mnt/memory/\"]}],\" outside the store directories are not scratch space there: the worker's file tools refuse to write to them, and anything a shell command writes there is never synced to a store.\"]}],[\"$\",\"p\",\"1\",{\"children\":[\"For a \",[\"$\",\"code\",\"1\",{\"children\":[\"read_only\"]}],\" store, the worker's \",[\"$\",\"code\",\"3\",{\"children\":[\"write\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"edit\"]}],\" tools refuse changes under that directory and the worker never uploads anything from it. To learn how the worker resolves write conflicts, and what the \",[\"$\",\"code\",\"7\",{\"children\":[\"bash\"]}],\" tool can still change in a read-only store's local copy, see \",[\"$\",\"$L2d\",\"9\",{\"href\":\"/docs/en/managed-agents/self-hosted-sandboxes#read-only-stores-and-conflicts\",\"children\":[\"Read-only stores and conflicts\"]}],\".\"]}]]}]\n46:[\"$\",\"p\",\"55\",{\"children\":[\"The agent's reads and writes appear in the \",[\"$\",\"$L2d\",\"1\",{\"href\":\"/docs/en/managed-agents/events-and-streaming\",\"children\":[\"event stream\"]}],\" as ordinary \",[\"$\",\"code\",\"3\",{\"children\":[\"agent.tool_use\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"agent.tool_result\"]}],\" events for whichever tool touched the mount.\"]}]\n47:[\"$\",\"$L2e\",\"57\",{\"level\":2,\"slug\":\"view-and-edit-memories\",\"children\":[\"View and edit memories\"]}]\n48:[\"$\",\"p\",\"59\",{\"children\":[\"Memory stores can be managed directly through the API. Use this for building review workflows, correcting bad memories, or seeding stores before any session runs.\"]}]\n49:[\"$\",\"$L2e\",\"61\",{\"level\":3,\"slug\":\"list-memories\",\"children\":[\"List memories\"]}]\n4a:[\"$\",\"p\",\"63\",{\"children\":[\"List the memories in a store. Results are returned in a stable, server-defined order.\"]}]\n4b:[\"$\",\"ul\",\"65\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"path_prefix\"]}],\" scopes the list to one directory. It must end with \",[\"$\",\"code\",\"2\",{\"children\":[\"/\"]}],\" and matches whole path segments, so \",[\"$\",\"code\",\"4\",{\"children\":[\"path_prefix=/notes/\"]}],\" returns \",[\"$\",\"code\",\"6\",{\"children\":[\"/notes/todo.md\"]}],\" but not \",[\"$\",\"code\",\"8\",{\"children\":[\"/notes-archive/todo.md\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"depth\"]}],\" controls how deep the listing goes below \",[\"$\",\"code\",\"2\",{\"children\":[\"path_prefix\"]}],\": omit it (or pass \",[\"$\",\"code\",\"4\",{\"children\":[\"0\"]}],\") to list the whole subtree, or pass \",[\"$\",\"code\",\"6\",{\"children\":[\"1\"]}],\" to list only the immediate children. Other values return a \",[\"$\",\"code\",\"8\",{\"children\":[\"400\"]}],\" error.\"]}],\"\\n\"]}]\na2:T723,\u003cpre class=\"shiki shiki-themes github-light-default dark-plus\" style=\"--shiki-light:#1f2328;--shiki-dark:#f3f7f6;--shiki-light-bg:transparent;--shiki-dark-bg:transparent\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#953800;--shiki-dark:#DCDCAA\"\u003ecurl\u003c/span\u003e\u003cspan style=\"--shiki-light:#0550AE;--shiki-dark:#569CD6\"\u003e -s\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e \"https://api.anthropic.com/v1/memory_stores/\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#9CDCFE\"\u003e$store_id\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e/memories?path_prefix=/\"\u003c/span\u003e\u003cspan style=\"--shiki-light:#CF222E;--shiki-dark:#D7BA7D\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0550AE;--shiki-dark:#569CD6\"\u003e  -H\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e \"x-api-key: \u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-