6\"\u003e  --path\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e \"/formatting_standards.md\"\u003c/span\u003e\u003cspan style=\"--shiki-light:#CF222E;--shiki-dark:#D7BA7D\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#0550AE;--shiki-dark:#569CD6\"\u003e  --content\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e \"All reports use GAAP formatting. Dates are ISO-8601...\"\u003c/span\u003e\u003cspan style=\"--shiki-light:#CF222E;--shiki-dark:#D7BA7D\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#CF222E;--shiki-dark:#f3f7f6\"\u003e  \u003e\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e /dev/null\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e38:[\"$\",\"$L84\",\"26\",{\"defaultLanguage\":\"CLI\",\"children\":[[\"$\",\"$L85\",\"0\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"cURL\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$8f\"}}]}],[\"$\",\"$L85\",\"1\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"CLI\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$90\"}}]}],\"$L91\",\"$L92\",\"$L93\",\"$L94\",\"$L95\",\"$L96\",\"$L97\"]}]\n39:[\"$\",\"$L2c\",\"28\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":[\"$\",\"$L98\",null,{\"name\":\"Lightbulb\",\"size\":\"auto\"}],\"className\":\"prose-block [.prose_\u0026]:text-prose\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Individual memories within the store are capped at 100 kB (~25k tokens). A store holds a maximum of 10,000 memories. Structure memory as many small focused files, not a few large ones.\"]}]]}]\n3a:[\"$\",\"$L2e\",\"30\",{\"level\":2,\"slug\":\"attach-a-memory-store-to-a-session\",\"children\":[\"Attach a memory store to a session\"]}]\n3b:[\"$\",\"p\",\"32\",{\"children\":[\"Memory stores are attached in the session's \",[\"$\",\"code\",\"1\",{\"children\":[\"resources[]\"]}],\" array when the \",[\"$\",\"$L2d\",\"3\",{\"href\":\"/docs/en/managed-agents/sessions#creating-a-session\",\"children\":[\"session is created\"]}],\". Unlike file resources, memory stores can only be attached at session creation time; adding or removing one from a running session is not supported. You attach memory stores the same way for sessions on cloud and \",[\"$\",\"$L2d\",\"5\",{\"href\":\"/docs/en/managed-agents/self-hosted-sandboxes#use-memory-stores\",\"children\":[\"self-hosted environments\"]}],\"; self-hosted environments accept only \",[\"$\",\"code\",\"7\",{\"children\":[\"memory_store\"]}],\" resources.\"]}]\n3c:[\"$\",\"p\",\"34\",{\"children\":[\"Optionally include \",[\"$\",\"code\",\"1\",{\"children\":[\"instructions\"]}],\" to provide session-specific guidance for how the agent should use this store. It is shown to the agent alongside the store's \",[\"$\",\"code\",\"3\",{\"children\":[\"name\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"description\"]}],\", and is capped at 4,096 characters.\"]}]\n3d:[\"$\",\"p\",\"36\",{\"children\":[\"You can configure \",[\"$\",\"code\",\"1\",{\"children\":[\"access\"]}],\" as well. It defaults to \",[\"$\",\"code\",\"3\",{\"children\":[\"read_write\"]}],\" (shown explicitly in the following example), but \",[\"$\",\"code\",\"5\",{\"children\":[\"read_only\"]}],\" is also supported.\"]}]\n99:Tf08,\u003cpre class=\"shiki shiki-themes github-light-default dark-plus\" style=\"--shiki-light:#1f2328;--shiki-dark:#f3f7f6;--shiki-light-bg:transparent;--shiki-dark-bg:transparent\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#953800;--shiki-dark:#DCDCAA\"\u003ecurl\u003c/span