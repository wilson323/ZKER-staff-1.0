<span class="line"><span style="--shiki-light:#0550AE;--shiki-dark:#569CD6">  --memory-store-id</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178"> "</span><span style="--shiki-light:#1F2328;--shiki-dark:#9CDCFE">$store_id</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178">"</span><span style="--shiki-light:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
