tyle=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e /dev/null\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e5e:[\"$\",\"$L84\",\"103\",{\"defaultLanguage\":\"CLI\",\"children\":[[\"$\",\"$L85\",\"0\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"cURL\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$cf\"}}]}],[\"$\",\"$L85\",\"1\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"CLI\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$d0\"}}]}],\"$Ld1\",\"$Ld2\",\"$Ld3\",\"$Ld4\",\"$Ld5\",\"$Ld6\",\"$Ld7\"]}]\n5f:[\"$\",\"p\",\"105\",{\"children\":[\"See the \",[\"$\",\"$L2d\",\"1\",{\"href\":\"/docs/en/api/beta/memory_stores/memories/delete\",\"children\":[\"Delete a memory reference\"]}],\" for full parameters and response schema.\"]}]\n60:[\"$\",\"$L2e\",\"107\",{\"level\":2,\"slug\":\"audit-memory-changes\",\"children\":[\"Audit memory changes\"]}]\n61:[\"$\",\"p\",\"109\",{\"children\":[\"Every mutation to a memory creates an immutable \",[\"$\",\"strong\",\"1\",{\"children\":[\"memory version\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"memver_...\"]}],\"). Use the version endpoints to audit who changed what and when, to inspect or restore a prior snapshot, and to scrub sensitive content out of history with redact.\"]}]\n62:[\"$\",\"p\",\"111\",{\"children\":[\"Versions belong to the store (not the individual memory) and are not deleted when the memory itself is deleted, so the audit trail also covers deleted memories, subject to the retention described below. Versions are retained for 30 days after they are written; however, the recent versions of a live memory are always kept regardless of age, so memories that change infrequently might retain history beyond 30 days. The live \",[\"$\",\"code\",\"1\",{\"children\":[\"memories.retrieve\"]}],\" call always returns the latest version; the version endpoints give you the retained history.\"]}]\n63:[\"$\",\"p\",\"113\",{\"children\":[\"There is no dedicated restore endpoint; to roll back, retrieve the version you want and write its \",[\"$\",\"code\",\"1\",{\"children\":[\"content\"]}],\" back with \",[\"$\",\"code\",\"3\",{\"children\":[\"memories.update\"]}],\" (or \",[\"$\",\"code\",\"5\",{\"children\":[\"memories.create\"]}],\" if the parent memory has been deleted, provided the version you want is still retained).\"]}]\n64:[\"$\",\"p\",\"115\",{\"children\":[\"Past memory versions might be deleted after 30 days. To preserve memory history for longer, export versions through the API.\"]}]\n65:[\"$\",\"$L2e\",\"117\",{\"level\":3,\"slug\":\"list-versions\",\"children\":[\"List versions\"]}]\n66:[\"$\",\"p\",\"119\",{\"children\":[\"List version history for a store, newest first. The example filters to a single memory's history:\"]}]\nd8:Tccf,\u003cpre class=\"shiki shiki-themes github-light-default dark-plus\" style=\"--shiki-light:#1f2328;--shiki-dark:#f3f7f6;--shiki-light-bg:transparent;--shiki-dark-bg:transparent\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#9CDCFE\"\u003eversions\u003c/span\u003e\u003cspan style=\"--shiki-light:#CF222E;--shiki-dark:#f3f7f6\"\u003e=\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003e$(\u003c/span\u003e\u003cspan style=\"--shiki-light:#953800;--shiki-dark:#DCDCAA\"\u003ecurl\u003c/span\u003e\u003cspan style=\"--shiki-light:#0550AE;--shiki-dark:#569CD6\"\u003e -s\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e \"https://api.anthropic.com/v1/memory_stores/\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#9CDCFE\"\u003e$store_id\u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u00