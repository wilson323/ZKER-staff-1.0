form-on-aws"><span class="h-full flex items-center min-w-0" id="_R_1bbdd5tpfibrad4plb_" data-trigger-disabled=""><span class="truncate py-1">Claude Platform on AWS</span></span></a></div></div></div><div class="flex-none border-t min-[72rem]:hidden"><div class="relative flex flex-col gap-1 p-md"><a class="group flex h-9 items-center gap-3 rounded border-y border-transparent bg-clip-padding px-2 aria-[current=page]:bg-fill-ghost-selected [&amp;:not([aria-current=page])]:hover:bg-fill-ghost-hover text-secondary aria-[current=page]:text-primary relative before:absolute before:inset-x-0 before:-inset-y-0.5 before:content-[&#x27;&#x27;]" data-testid="docs-nav-console-full" href="/"><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" class="shrink-0" aria-hidden="true"></span><span data-cds="OverflowTooltip" class="block truncate relative flex-1 text-body" id="_R_16hd5tpfibrad4plb_" data-base-ui-tooltip-trigger="">Console</span></a></div></div></aside><div class="flex flex-col w-full min-w-0 lg:pl-66"><main id="docs-scroll-container" class="flex-1 bg-surface-1"><div class="px-md pt-md empty:hidden"></div><div class="w-full min-h-[calc(100vh-3.5rem)]"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Managed Agents","item":"https://platform.claude.com/docs/en/managed-agents/overview"},{"@type":"ListItem","position":2,"name":"Using agent memory","item":"https://platform.claude.com/docs/en/managed-agents/memory"}]}</script><div class="w-full relative max-w-screen-2xl flex justify-center lg:justify-between mx-auto shrink"><div class="hidden min-[91.875rem]:block"></div><article id="content-container" class="mx-auto w-full min-w-0 max-w-5xl px-6 py-8 lg:max-w-4xl lg:p-8"><div data-cds="Prose" data-prose-font="sans" data-prose-heading-font="serif" data-prose-spacing="lg" data-size="sm" class="prose docs-prose"><header class="mb-lg