"p\",\"6\",{\"children\":[\"The input store is never modified, so you can review the output and discard it if you don't like the result.\"]}],\"\\n\",[\"$\",\"$L2c\",\"8\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block [.prose_\u0026]:text-prose\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Dream endpoints are gated by the \",[\"$\",\"code\",\"1\",{\"children\":[\"dreaming-2026-04-21\"]}],\" beta header; the \",[\"$\",\"code\",\"3\",{\"children\":[\"managed-agents-2026-04-01\"]}],\" header on its own doesn't grant access to dreams. The dream-endpoint examples on this page send both headers; session and memory-store calls need only \",[\"$\",\"code\",\"5\",{\"children\":[\"managed-agents-2026-04-01\"]}],\". The SDK sets these automatically.\"]}]]}],\"\\n\",[\"$\",\"$L2f\",\"10\",{\"level\":2,\"slug\":\"how-it-works\",\"children\":[\"How it works\"]}],\"\\n\",[\"$\",\"p\",\"12\",{\"children\":[\"A \",[\"$\",\"strong\",\"1\",{\"children\":[\"dream\"]}],\" is an asynchronous job that takes:\"]}],\"\\n\",[\"$\",\"ul\",\"14\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"a pre-existing \",[\"$\",\"strong\",\"1\",{\"children\":[\"memory store:\"]}],\" the store Claude verifies, deduplicates, and reorganizes, and\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"1 to 100 \",[\"$\",\"strong\",\"1\",{\"children\":[\"sessions:\"]}],\" past transcripts Claude mines for patterns and insights to fold into the output.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"16\",{\"children\":[\"The dream produces another \",[\"$\",\"strong\",\"1\",{\"children\":[\"output memory store\"]}],\", separate from the input. The output store ID appears in the dream's \",[\"$\",\"code\",\"3\",{\"children\":[\"outputs[]\"]}],\" shortly after the dream starts \",[\"$\",\"code\",\"5\",{\"children\":[\"running\"]}],\", once the workflow has cloned the input store; a \",[\"$\",\"code\",\"7\",{\"children\":[\"running\"]}],\" dream can briefly 