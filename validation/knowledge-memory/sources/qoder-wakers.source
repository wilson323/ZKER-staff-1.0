ll,{\"children\":\"说明先分析、再执行、如何验证和何时汇报\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"红线与边界\"}],[\"$\",\"td\",null,{\"children\":\"明确禁止访问、修改、发布和外发的内容\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"工作流程\"}],[\"$\",\"td\",null,{\"children\":\"用顺序步骤说明正常路径和异常处理\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"Skills / 连接器\"}],[\"$\",\"td\",null,{\"children\":\"只选择当前职责确实需要的能力\"}]]}]]}]]}]\n33:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-custom-manual_b7743da1e1ef.png\",\"alt\":\"手动填写自定义 Waker\"}]}]\n34:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"创建后如果发现职责需要大幅重写，先停用自动任务和外部入口，再调整角色文件并重新验证，避免新旧行为同时发生。\"}]\n35:[\"$\",\"$L19\",null,{\"level\":\"2\",\"id\":\"使用-waker-详情页\",\"children\":\"使用 Waker 详情页\"}]\n36:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"从 Waker 管理页或左侧员工列表打开一个 Waker。新版详情页按工作阶段组织配置：\"}]\n37:[\"$\",\"$L1b\",null,{\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"children\":\"分组\"}],[\"$\",\"th\",null,{\"children\":\"页面\"}],[\"$\",\"th\",null,{\"children\":\"用途\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"首页\"}],[\"$\",\"td\",null,{\"children\":\"首页\"}],[\"$\",\"td\",null,{\"children\":\"查看身份、状态、活动和资源概览\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"工作\"}],[\"$\",\"td\",null,{\"children\":\"任务看板、自主工作\"}],[\"$\",\"td\",null,{\"children\":\"查看任务，配置自动触发\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"记忆与学习\"}],[\"$\",\"td\",null,{\"children\":\"记忆、自我进化 Skills\"}],[\"$\",\"td\",null,{\"children\":\"管理长期记忆和学习形成的能力\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"能力与资源\"}],[\"$\",\"td\",null,{\"children\":\"Skills、连接器、WakerFlow、知识库、项目\"}],[\"$\",\"td\",null,{\"childre"])</script><script>self.__next_f.push([1,"n\":\"控制可用工具和工作上下文\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"协作与管理\"}],[\"$\",\"td\",null,{\"children\":\"权限、设置\"}],[\"$\",\"td\",null,{\"children\":\"控制风险边界和角色配置\"}]]}]]}]]}]\n38:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-home_b7743da1e1ef.png\",\"alt\":\"按工作阶段查看 Waker 首页和各项配置\"}]}]\n39:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"配置能力时，先确认资源本身可用，再确认它已经分配给当前 Waker。例如，连接器安装成功但没有授予当前 Waker，任务中仍然不能使用；知识库存在但未绑定，也不会自动进入回答上下文。\"}]\n3a:[\"$\",\"$L19\",null,{\"level\":\"2\",\"id\":\"配置权限\",\"children\":\"配置权限\"}]\n3b:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"进入 Waker 详情页的「权限」。新版权限页会按工具防护、文件防护、内置工具和模型安全等维度展示控制项。\"}]\n3c:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-permissions_b7743da1e1ef.png\",\"alt\":\"配置 Waker 权限\"}]}]\n3d:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"从最小权限开始，只开放当前职责所需的目录和工具。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"对删除、覆盖、外部发送、生产变更、付款和发布保留人工确认。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"如果允许成员通过 IM 修改 Waker 配置，先限定可操作的成员和聊天范围。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"保存后用一条低风险任务验证：需要授权的操作应出现确认，不允许的操作应被阻止。\"}],\"\\n\"]}]\n3e:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"权限规则只约束后续操作，不会撤销之前已经发生的文件或外部系统变更。权限放宽后要新建聊天验证；旧聊天可能仍带有变更前的上下文或授权状态。\"}]\n3f:[\"$\",\"$L19\",null,{\"level\":\"2\",\"id\":\"修改角色与基础设置\",\"children\":\"修改角色与基础设置\"}]\n40:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"进入「设置」可以查看角色摘要和源文件，并维护名称、头像、简介、启用状态等基础信息。\"}]\n41:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-settings_b7743da1e1ef.png\",\"alt\":\"Waker 设置页\"}]}]\n42:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"编辑角色时先判断修改范围：\"}]\n43:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"仅名称、头像或简介变化：修改基础信息即可。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"职责或边界变化：同步检查角色源文件、Skills、连接器和权限。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"运行环境或目录变化：重新验证文件访问、项目路径和自动任务。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"角色用途完全变化：建议新建 Waker，保留旧 Waker 便于回溯。\"}],\"\\n\"]}]\n44:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"角色文件修改后，用以下三类任务重新验证：职责内的正常任务、职责外的拒绝任务、需要人工确认的高风险任务。\"}]\n45:[\"$\",\"$L19\",null,{\"level\":\"2\",\"id\":\"创建和维护-group\",\"children\":\"创建和维护 Group\"}]\n46:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"Group 用于让多个职责互补的 Waker 通过同一个聊天入口协作。用户把目标交给团队后，Leader 负责理解请求和组织分工，成员 Waker 按各自职责执行，最终进展和结果仍回到同一个任务中。\"}]\n47:[\"$\",\"$L19\",null,{\"level\":\"3\",\"id\":\"创建-group\",\"children\":\"创建 Group\"}]\n48:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"进入「Waker 管理」，切换到 \",[\"$\",\"code\",null,{\"children\":\"Group\"}],\"，点击「"])</script><script>self.__next_f.push([1,"新建群组」。\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"填写能够体现共同目标的群聊标题，例如“版本交付组”。标题会出现在员工栏、任务看板和聊天中。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"在左侧选择成员。至少加入一位能够完成主要工作的 Waker；需要研发、评审、测试等分工时，再加入职责互补的成员。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"指定一位 Leader。Leader 负责接收 Group 请求、决定先后顺序、组织成员和汇总结果。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"逐个选择成员，在右侧确认响应模型和工作目录。多人访问同一目录时，明确主修改者和只读评审者，避免并发覆盖。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"确认页面底部的已配置成员数量，再点击「创建」。\"}],\"\\n\"]}]\n49:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/group-create_b7743da1e1ef.png\",\"alt\":\"创建并配置 Group\"}]}]\n4a:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"创建页左侧用于选人，右侧用于配置当前选中的 Waker。只勾选成员但没有完成右侧配置时，不能视为已经完成 Group 设置。\"}]\n4b:[\"$\",\"$L19\",null,{\"level\":\"3\",\"id\":\"验证-group-分工\",\"children\":\"验证 Group 分工\"}]\n4c:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"创建后点击 Group 卡片中的「创建对话任务」，先用一条小范围任务验证：\"}]\n4d:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Leader 是否先确认目标，再把子任务交给合适的成员。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"每个成员是否使用预期的模型、工作目录和权限。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"同一文件是否只有明确的主修改者，评审者是否保持只读。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"中间进展、人工确认和最终结果是否都能在同一个任务中查看。\"}],\"\\n\"]}]\n4e:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"调整成员、Leader、模型或目录后，新建任务重新验证。删除 Group 不会删除成员 Waker，但会中断依赖该团队的聊天入口；删除前先处理运行中任务并保存需要保留的产物。\"}]\n4f:[\"$\",\"$L19\",null,{\"level\":\"2\",\"id\":\"停用或删除前检查\",\"children\":\"停用或删除前检查\"}]\n50:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"停用 Waker 会阻止新的工作，但不会撤销已经完成的修改。删除前依次检查：\"}]\n51:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"是否仍有运行中或待确认的对话任务。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"是否被自主工作或 WakerFlow 引用。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"是否属于 Group，或被 @Waker / IM 聊天使用。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"是否有需要保留的产物、记忆或角色配置。\"}],\"\\n\"]}]\n52:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"先暂停外部触发和自动任务，再处理依赖关系，最后停用或删除。\"}]\n53:[\"$\",\"$L19\",null,{\"level\":\"2\",\"id\":\"上线检查\",\"children\":\"上线检查\"}]\n54:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"名称、职责、运行环境和状态与预期一致。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Skills、连接器、知识库和项目均为完成职责所必需。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"正常任务、越界任务和高风险确认各验证一次。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"普通对话、自主工作、Group 或 IM 入口分别完成过小范围测试。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"测试数据没有写入正式目录，截图不包含敏感信息。\"}],\"\\n\"]}]\n55:[\"$\",\"$L57\",null,{\"content\":\"$6:props:initialState:content\",\"headings\":\"$6:props:initialState:headings\",\"page\":\"$6:props:initialState:page\",\"navTree\":\"$6:props:initialState:navTree\",\"config\":\"$3:props:config\",\"prev\":\"$6:props:initialState:prev\",\"next\":\"$6:props:initialState:next\",\"basePath\":\"\"}]\nc:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\""])</script><script>self.__next_f.push([1,"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n9:null\ne:[[\"$\",\"title\",\"0\",{\"children\":\"Waker 管理 - Qoder CN\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"从预置角色或自定义配置创建 Waker，并完成能力、权限、运行环境和 Group 管理。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.png\"}],[\"$\",\"$L58\",\"3\",{}]]\n"])</script></body></html>