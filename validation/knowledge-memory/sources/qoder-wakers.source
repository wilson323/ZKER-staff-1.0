sidebar-title">命令行工具</span></div><ul class="relative flex flex-col gap-px w-full lg:min-w-[var(--adoc-sidebar-toc-width)]"><li id="/qoderwake/cli-reference" class="relative z-[1] scroll-m-4 first:scroll-m-20 list-none" data-title="命令行工具（CLI）"><a class="group flex items-start w-full cursor-pointer text-left break-words outline-offset-[-1px] text-[var(--adoc-sidebar-text-size)] leading-[var(--adoc-sidebar-text-leading)] min-h-8 font-normal rounded-[var(--adoc-radius-sm,8px)] text-neutral-700 dark:text-adoc-text-secondary mint-sidebar-item-hover" style="padding:6px 12px 6px 24px" href="/qoderwake/cli-reference"><span class="min-w-0 flex-1 break-words text-[var(--adoc-sidebar-text-size)] leading-[var(--adoc-sidebar-text-leading)]">命令行工具（CLI）</span></a></li></ul></div><div class="flex flex-col gap-2 w-full lg:min-w-[var(--adoc-sidebar-toc-width)] mt-8 first:mt-0"><div class="flex flex-row items-center gap-2 min-h-8 text-neutral-950" style="padding:6px 12px 6px 24px"><span class="text-[var(--adoc-sidebar-text-size)] font-medium leading-[var(--adoc-sidebar-text-leading)] flex-1 min-w-0 break-words sidebar-title">支持</span></div><ul class="relative flex flex-col gap-px w-full lg:min-w-[var(--adoc-sidebar-toc-width)]"><li id="/qoderwake/troubleshooting" class="relative z-[1] scroll-m-4 first:scroll-m-20 list-none" data-title="故障排查"><a class="group flex items-start w-full cursor-pointer text-left break-words outline-offset-[-1px] text-[var(--adoc-sidebar-text-size)] leading-[var(--adoc-sidebar-text-leading)] min-h-8 font-normal rounded-[var(--adoc-radius-sm,8px)] text-neutral-700 dark:text-adoc-text-secondary mint-sidebar-item-hover" style="padding:6px 12px 6px 24px" href="/qoderwake/troubleshooting"><span class="min-w-0 flex-1 break-words text-[var(--adoc-sidebar-text-size)] leading-[var(--adoc-sidebar-text-leading)]">故障排查</span></a></li></ul></div></div></div></nav></div><div id="content-container-0" class="flex-1 min-w-0 bg-neutral-50 flex flex-col"><div id="content" class="mdx-content relative flex-1 mt-[var(--adoc-content-top-gap)]" data-page-title="" data-page-href=""><div id="main-content"><div class="content-container" data-page-mode="default" data-page-title="Waker 管理" data-page-href="qoderwake/manage-wakers"><div class="flex w-full"><div class="content-area @container flex-1 min-w-0 min-h-[calc(100vh-var(--topbar-height))] w-full overflow-x-visible rounded-[16px] px-[var(--adoc-content-padding)] py-[var(--adoc-content-padding-y)]  min-lg:mr-0" id="content-area"><div class="w-full overflow-x-visible mx-auto" style="max-width:var(--adoc-content-max-width)"><div class="eyebrow text-caption-c1 text-primary-550">员工资源</div><header class="mt-2.5 space-y-2.5"><div class="flex flex-col sm:flex-row items-start sm:items-center relative gap-12 min-w-0 justify-between"><h1 id="page-title" class="page-title font-bold text-neutral-950 tracking-tight [overflow-wrap:anywhere]">Waker 管理</h1><div class="hidden @[520px]:flex"><div id="page-context-menu" class="relative flex items-center shrink-0 min-w-[143px] justify-end "><div class="flex min-h-15 items-stretch overflow-hidden rounded-[var(--adoc-radius-sm,8px)] border border-line-200 bg-background-light"><button type="button" id="page-context-menu-button" aria-label="复制页面" data-tracker-params="adoc_docs_copy_page" class="flex items-center rounded-none rounded-l-[var(--adoc-radius-sm,8px)] border-r border-line-200 pl-6 pr-4 py-3 font-normal text-neutral-950 transition-colors duration-150 cursor-pointer hover:bg-neutral-150"><div class="flex h-10 items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy icon inline dark:text-adoc-primary-light shrink-0 text-neutral-950" aria-hidden="true" style="width:16px;height:16px;display:inline-block;vertical-align:middle;color:currentColor"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg><span class="text-[14px] leading-[20px] text-neutral-750">复制页面</span></div></button><button aria-label="More actions" aria-haspopup="menu" aria-expanded="false" type="button" data-tracker-params="adoc_docs_copy_page_more" class="group flex items-center justify-center rounded-none rounded-r-[var(--adoc-radius-sm,8px)] pl-4 pr-6 py-3 transition-colors duration-150 text-neutral-950 cursor-pointer hover:bg-neutral-150 "><span class="inline-flex h-10 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down icon inline dark:text-adoc-primary-light text-neutral-950 transition-transform duration-200" aria-hidden="true" style="width:16px;height:16px;display:inline-block;vertical-align:middle;color:currentColor"><path d="m6 9 6 6 6-6"></path></svg></span></button></div></div></div></div></header><article class="w-full overflow-x-visible mx-auto" style="max-width:var(--adoc-content-max-width)"><div class="prose content mt-4 text-[14px] leading-[22px]"><p class="m-0" node="[object Object]">从预置角色或自定义配置创建 Waker，并完成能力、权限、运行环境和 Group 管理。</p></div><div class="flex @[520px]:hidden mt-4"><div id="page-context-menu" class="relative flex items-center shrink-0 min-w-[143px] justify-end "><div class="flex min-h-15 items-stretch overflow-hidden rounded-[var(--adoc-radius-sm,8px)] border border-line-200 bg-background-light"><button type="button" id="page-context-menu-button" aria-label="复制页面" data-tracker-params="adoc_docs_copy_page" class="flex items-center rounded-none rounded-l-[var(--adoc-radius-sm,8px)] border-r border-line-200 pl-6 pr-4 py-3 font-normal text-neutral-950 transition-colors duration-150 cursor-pointer hover:bg-neutral-150"><div class="flex h-10 items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy icon inline dark:text-adoc-primary-light shrink-0 text-neutral-950" aria-hidden="true" style="width:16px;height:16px;display:inline-block;vertical-align:middle;color:currentColor"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg><span class="text-[14px] leading-[20px] text-neutral-750">复制页面</span></div></button><button aria-label="More actions" aria-haspopup="menu" aria-expanded="false" type="button" data-tracker-params="adoc_docs_copy_page_more" class="group flex items-center justify-center rounded-none rounded-r-[var(--adoc-radius-sm,8px)] pl-4 pr-6 py-3 transition-colors duration-150 text-neutral-950 cursor-pointer hover:bg-neutral-150 "><span class="inline-flex h-10 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down icon inline dark:text-adoc-primary-light text-neutral-950 transition-transform duration-200" aria-hidden="true" style="width:16px;height:16px;display:inline-block;vertical-align:middle;color:currentColor"><path d="m6 9 6 6 6-6"></path></svg></span></button></div></div></div><div class="adoc-mdx-content"><div class="prose content dark:prose-invert max-w-none mt-6"><span data-as="p">Waker 是 QoderWake 中承担具体职责的数字员工。一个可稳定工作的 Waker，不仅要有名称和角色说明，还需要明确运行环境、工作边界、可用资源以及高风险操作的确认方式。</span>
<span data-as="p">建议先用一个小任务验证角色，再逐步添加 Skills、连接器、知识库和项目。不要把互相冲突的职责堆进同一个 Waker；职责差异明显时，创建多个 Waker 或使用 Group 协作。</span>
<h2 id="查看-waker-与-group" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#查看-waker-与-group" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>查看 Waker 与 Group</span></h2>
<span data-as="p"><strong>入口：</strong> 左侧导航 →「Waker 管理」。页面上方可在 <code>Waker</code> 和 <code>Group</code> 之间切换；左侧员工栏用于快速进入已有 Waker 或 Group。</span>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/rework-waker-management_b7743da1e1ef.png" alt="Waker 管理页"/></div></div></span>
<span data-as="p">Waker 列表用于确认以下信息：</span>
<div data-table-wrapper="true" class="[--page-padding:20px] overflow-x-auto flex w-[calc(100%+(var(--page-padding)*2))] my-[1em] py-[1em] -mx-[var(--page-padding)] max-w-none [contain:inline-size]"><div class="px-[var(--page-padding)] grow max-w-none table"><table class="!m-0 table"><thead><tr><th>信息</th><th>说明</th><th>需要处理的情况</th></tr></thead><tbody><tr><td>名称和职责</td><td>用于选择执行者和任务路由</td><td>名称相近或职责重叠时先调整</td></tr><tr><td>运行环境</td><td>本地、远端或当前绑定设备</td><td>本地设备离线时，本地目录任务无法执行</td></tr><tr><td>状态</td><td>是否启用、是否可运行</td><td>停用或离线时先恢复状态</td></tr><tr><td>最近工作</td><td>最近任务及进度</td><td>长时间无结果时打开任务详情排查</td></tr></tbody></table></div></div>
<span data-as="p">找不到目标 Waker 时，先切回 <code>Waker</code> 列表并清空搜索；如果页面提供状态或环境筛选，再确认目标没有被筛掉。Group 列表只展示已经创建的团队，不会自动把职责相近的 Waker 归为一组。</span>
<span data-as="p">切换到 <code>Group</code> 后，可以查看成员头像、打开已有 Group、直接创建对话任务，或通过更多操作维护团队。卡片中的多个头像代表成员 Waker；没有成员头像时，应先打开团队检查配置。</span>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/group-list_b7743da1e1ef.png" alt="查看和管理 Group"/></div></div></span>
<h3 id="区分本地与远端-waker" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#区分本地与远端-waker" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>区分本地与远端 Waker</span></h3>
<span data-as="p">Waker 卡片会标明 <code>Local</code> 或 <code>Remote</code>、所在设备和在线状态。这里的“远端”表示 Waker 运行在同一账号可见的另一台设备上，文件、连接器凭据和进程仍位于那台设备，并不会复制到当前电脑。</span>
<ul>
<li>本地 Waker 通常可以直接管理和发起对话。</li>
<li>远端 Waker 是否可以对话或配置，取决于远端设备是否在线、是否开启远端管理，以及当前账号获得的权限。</li>
<li>卡片显示“无远程聊天权限”时，不要反复点击或重新创建同名 Waker；先由远端设备所有者检查账号、设备状态和远端配置授权。</li>
<li>可以发起远程任务时，仍要选择远端设备实际存在的目录或项目。当前电脑上的本地路径不会自动映射过去。</li>
</ul>
<span data-as="p">修改远端 Waker 的角色、Skill、连接器或权限后，在远端环境执行一条只读任务验证。认证凭据不会随远端配置同步；连接器提示未授权时，应在凭据实际所在的设备重新完成授权。</span>
<h2 id="从预置角色创建-waker" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#从预置角色创建-waker" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>从预置角色创建 Waker</span></h2>
<span data-as="p">预置角色已经包含建议的职责、工作方式和基础能力，适合首次创建或常见岗位。实际可选角色以当前版本页面为准。</span>
<ol>
<li>点击左侧「新建 Waker」或 Waker 管理页中的新建入口。</li>
<li>浏览角色列表。研发、测试、设计、产品、数据、内容运营和群聊答疑等角色分别面向不同任务。</li>
</ol>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-market_b7743da1e1ef.png" alt="从角色市场选择预置角色或自定义 Waker"/></div></div></span>
<ol start="3">
<li>点击角色卡片，阅读核心能力、工作风格、工作模式和预装 Skills。</li>
</ol>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-preset-detail_b7743da1e1ef.png" alt="查看预置角色详情"/></div></div></span>
<ol start="4">
<li>点击「就他了！」进入「完善信息」，填写 Waker 名称。名称应体现岗位或服务对象，例如“官网前端维护”或“客户问题分析”，避免只写“助手”。</li>
<li>确认运行环境。需要访问本机文件或应用时选择对应设备；只处理云端资源时按页面提供的环境选择。</li>
<li>检查预装 Skills、知识库和连接器。创建阶段只保留确定需要的能力，后续可以在详情页继续补充。</li>
</ol>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-preset-form_b7743da1e1ef.png" alt="填写预置 Waker 的创建信息"/></div></div></span>
<ol start="7">
<li>点击「创建 Waker」。创建完成后进入 Waker 首页，确认名称、职责、状态和运行环境与预期一致。</li>
<li>发起一条只读任务，例如“说明你的职责边界，并检查当前目录中有哪些文件，不要修改内容”。确认角色和目录均正确后再开展正式工作。</li>
</ol>
<span data-as="p">如果预置角色大体合适但个别职责不同，先基于预置角色创建，再在「设置」中调整角色文件；只有结构差异较大时才建议从自定义角色开始。</span>
<h2 id="创建自定义-waker" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#创建自定义-waker" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>创建自定义 Waker</span></h2>
<span data-as="p">点击「自定义 Waker」后，先填写角色名称、简介和头像，再选择配置方式。</span>
<h3 id="使用智能生成" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#使用智能生成" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>使用智能生成</span></h3>
<span data-as="p">智能生成适合已经能用自然语言说明岗位，但还没有完整角色文件的情况。</span>
<ol>
<li>在描述中写清服务对象、主要任务、常见输入、交付物、不可执行的操作，以及何时请求人工确认。</li>
<li>点击生成，等待系统形成职责、工作方式、边界和建议能力。</li>
<li>逐项检查生成内容。删除宽泛承诺，补充业务范围、目录范围和高风险操作的确认条件。</li>
<li>只添加完成工作所需的 Skills 和连接器。需要知识资料时绑定对应知识库，不要把凭据写进角色描述。</li>
</ol>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-custom-ai_b7743da1e1ef.png" alt="通过智能生成创建自定义 Waker"/></div></div></span>
<span data-as="p">可使用下面的结构组织角色描述：</span>
<div class="code-block not-prose group relative mt-5 mb-8 rounded-2xl codeblock-light dark:twoslash-dark border border-stone-950/10 text-stone-950 dark:border-white/10 dark:text-stone-50 bg-transparent dark:bg-transparent"><div class="absolute top-3 right-4 flex items-center gap-1.5" data-floating-buttons="true"><div class="relative z-10 select-none"><button aria-label="Copy the contents from the code block" class="peer group/copy-button flex size-[26px] items-center justify-center rounded-md backdrop-blur" data-testid="copy-code-button" type="button"><svg class="size-4 text-stone-400 group-hover/copy-button:text-stone-500 dark:text-white/40 dark:group-hover/copy-button:text-white/60" fill="none" height="18" viewBox="0 0 18 18" width="18" xmlns="http://www.w3.org/2000/svg"><title>Copy</title><path d="M14.25 5.25H7.25C6.14543 5.25 5.25 6.14543 5.25 7.25V14.25C5.25 15.3546 6.14543 16.25 7.25 16.25H14.25C15.3546 16.25 16.25 15.3546 16.25 14.25V7.25C16.25 6.14543 15.3546 5.25 14.25 5.25Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M2.80103 11.998L1.77203 5.07397C1.61003 3.98097 2.36403 2.96397 3.45603 2.80197L10.38 1.77297C11.313 1.63397 12.19 2.16297 12.528 3.00097" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></button><div aria-hidden="true" class="absolute -top-3 left-1/2 -translate-x-1/2 -translate-y-1/2 transform whitespace-nowrap rounded-lg bg-stone-900 px-1.5 py-0.5 text-white text-xs opacity-0 peer-hover:opacity-100 dark:bg-stone-100 dark:text-stone-900">Copy</div></div></div><div class="children:!my-0 children:!shadow-none children:!bg-transparent relative h-full w-0 min-w-full max-w-full px-4 py-3.5 text-sm leading-6 dark:bg-[#0B0C0E] code-block-background transition-[height] duration-300 ease-in-out **:outline-0 **:ring-0 **:focus:outline-0 **:focus:ring-0 rounded-2xl bg-white overflow-x-auto scrollbar-code-system" data-component-part="code-block-root" style="font-variant-ligatures:none;height:auto;background-color:#ffffff;--shiki-dark-bg:#0B0C0E"><div class="font-mono whitespace-pre leading-6"><pre class="shiki shiki-themes github-light-default dark-plus" style="background-color:#ffffff;--shiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="text"><code language="text"><span class="line"><span>服务对象：谁会把任务交给这个 Waker。</span></span>
<span class="line"><span>主要职责：需要稳定完成的 3～5 类任务。</span></span>
<span class="line"><span>输入：会接收哪些目录、文件、消息或业务字段。</span></span>
<span class="line"><span>交付：返回哪些文档、代码、表格、链接或结论。</span></span>
<span class="line"><span>边界：不能访问或修改什么。</span></span>
<span class="line"><span>确认：哪些删除、发布、外发或生产操作必须等待人工同意。</span></span>
<span class="line"><span></span></span></code></pre></div></div><div aria-hidden="true" data-fade-overlay="true" style="--fade-color-light:#ffffff;--fade-color-dark:#0B0C0E"></div></div>
<h3 id="上传-markdown-配置" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#上传-markdown-配置" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>上传 Markdown 配置</span></h3>
<span data-as="p">上传 Markdown 适合已经有经过评审的角色配置，或需要把同一套角色配置迁移到另一环境。</span>
<ol>
<li>下载页面提供的空白模板。</li>
<li>按模板维护 <code>identity.md</code>、<code>persona.md</code> 和 <code>bible.md</code> 等角色文件，不要随意改变文件职责。</li>
<li>上传文件并检查解析结果；凭据、本机绝对路径和个人信息不要写入角色文件。</li>
<li>创建后打开「设置」逐个核对源文件，再用新聊天验证。</li>
</ol>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-custom-markdown_b7743da1e1ef.png" alt="上传 Markdown 角色配置"/></div></div></span>
<h3 id="手动填写" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#手动填写" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>手动填写</span></h3>
<span data-as="p">手动填写适合边界要求严格、需要逐项审查的岗位。</span>
<div data-table-wrapper="true" class="[--page-padding:20px] overflow-x-auto flex w-[calc(100%+(var(--page-padding)*2))] my-[1em] py-[1em] -mx-[var(--page-padding)] max-w-none [contain:inline-size]"><div class="px-[var(--page-padding)] grow max-w-none table"><table class="!m-0 table"><thead><tr><th>配置项</th><th>建议写法</th></tr></thead><tbody><tr><td>核心职责</td><td>使用动词开头，写清对象和产物</td></tr><tr><td>工作方式</td><td>说明先分析、再执行、如何验证和何时汇报</td></tr><tr><td>红线与边界</td><td>明确禁止访问、修改、发布和外发的内容</td></tr><tr><td>工作流程</td><td>用顺序步骤说明正常路径和异常处理</td></tr><tr><td>Skills / 连接器</td><td>只选择当前职责确实需要的能力</td></tr></tbody></table></div></div>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-custom-manual_b7743da1e1ef.png" alt="手动填写自定义 Waker"/></div></div></span>
<span data-as="p">创建后如果发现职责需要大幅重写，先停用自动任务和外部入口，再调整角色文件并重新验证，避免新旧行为同时发生。</span>
<h2 id="使用-waker-详情页" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#使用-waker-详情页" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>使用 Waker 详情页</span></h2>
<span data-as="p">从 Waker 管理页或左侧员工列表打开一个 Waker。新版详情页按工作阶段组织配置：</span>
<div data-table-wrapper="true" class="[--page-padding:20px] overflow-x-auto flex w-[calc(100%+(var(--page-padding)*2))] my-[1em] py-[1em] -mx-[var(--page-padding)] max-w-none [contain:inline-size]"><div class="px-[var(--page-padding)] grow max-w-none table"><table class="!m-0 table"><thead><tr><th>分组</th><th>页面</th><th>用途</th></tr></thead><tbody><tr><td>首页</td><td>首页</td><td>查看身份、状态、活动和资源概览</td></tr><tr><td>工作</td><td>任务看板、自主工作</td><td>查看任务，配置自动触发</td></tr><tr><td>记忆与学习</td><td>记忆、自我进化 Skills</td><td>管理长期记忆和学习形成的能力</td></tr><tr><td>能力与资源</td><td>Skills、连接器、WakerFlow、知识库、项目</td><td>控制可用工具和工作上下文</td></tr><tr><td>协作与管理</td><td>权限、设置</td><td>控制风险边界和角色配置</td></tr></tbody></table></div></div>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-home_b7743da1e1ef.png" alt="按工作阶段查看 Waker 首页和各项配置"/></div></div></span>
<span data-as="p">配置能力时，先确认资源本身可用，再确认它已经分配给当前 Waker。例如，连接器安装成功但没有授予当前 Waker，任务中仍然不能使用；知识库存在但未绑定，也不会自动进入回答上下文。</span>
<h2 id="配置权限" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#配置权限" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>配置权限</span></h2>
<span data-as="p">进入 Waker 详情页的「权限」。新版权限页会按工具防护、文件防护、内置工具和模型安全等维度展示控制项。</span>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-permissions_b7743da1e1ef.png" alt="配置 Waker 权限"/></div></div></span>
<ol>
<li>从最小权限开始，只开放当前职责所需的目录和工具。</li>
<li>对删除、覆盖、外部发送、生产变更、付款和发布保留人工确认。</li>
<li>如果允许成员通过 IM 修改 Waker 配置，先限定可操作的成员和聊天范围。</li>
<li>保存后用一条低风险任务验证：需要授权的操作应出现确认，不允许的操作应被阻止。</li>
</ol>
<span data-as="p">权限规则只约束后续操作，不会撤销之前已经发生的文件或外部系统变更。权限放宽后要新建聊天验证；旧聊天可能仍带有变更前的上下文或授权状态。</span>
<h2 id="修改角色与基础设置" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#修改角色与基础设置" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>修改角色与基础设置</span></h2>
<span data-as="p">进入「设置」可以查看角色摘要和源文件，并维护名称、头像、简介、启用状态等基础信息。</span>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-settings_b7743da1e1ef.png" alt="Waker 设置页"/></div></div></span>
<span data-as="p">编辑角色时先判断修改范围：</span>
<ul>
<li>仅名称、头像或简介变化：修改基础信息即可。</li>
<li>职责或边界变化：同步检查角色源文件、Skills、连接器和权限。</li>
<li>运行环境或目录变化：重新验证文件访问、项目路径和自动任务。</li>
<li>角色用途完全变化：建议新建 Waker，保留旧 Waker 便于回溯。</li>
</ul>
<span data-as="p">角色文件修改后，用以下三类任务重新验证：职责内的正常任务、职责外的拒绝任务、需要人工确认的高风险任务。</span>
<h2 id="创建和维护-group" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#创建和维护-group" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>创建和维护 Group</span></h2>
<span data-as="p">Group 用于让多个职责互补的 Waker 通过同一个聊天入口协作。用户把目标交给团队后，Leader 负责理解请求和组织分工，成员 Waker 按各自职责执行，最终进展和结果仍回到同一个任务中。</span>
<h3 id="创建-group" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#创建-group" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>创建 Group</span></h3>
<ol>
<li>进入「Waker 管理」，切换到 <code>Group</code>，点击「新建群组」。</li>
<li>填写能够体现共同目标的群聊标题，例如“版本交付组”。标题会出现在员工栏、任务看板和聊天中。</li>
<li>在左侧选择成员。至少加入一位能够完成主要工作的 Waker；需要研发、评审、测试等分工时，再加入职责互补的成员。</li>
<li>指定一位 Leader。Leader 负责接收 Group 请求、决定先后顺序、组织成员和汇总结果。</li>
<li>逐个选择成员，在右侧确认响应模型和工作目录。多人访问同一目录时，明确主修改者和只读评审者，避免并发覆盖。</li>
<li>确认页面底部的已配置成员数量，再点击「创建」。</li>
</ol>
<span data-as="p"><div aria-owns="rmiz-modal-" data-rmiz=""><div data-rmiz-content="not-found" style="visibility:visible"><img class="image" data-component-part="image" src="https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/group-create_b7743da1e1ef.png" alt="创建并配置 Group"/></div></div></span>
<span data-as="p">创建页左侧用于选人，右侧用于配置当前选中的 Waker。只勾选成员但没有完成右侧配置时，不能视为已经完成 Group 设置。</span>
<h3 id="验证-group-分工" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#验证-group-分工" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>验证 Group 分工</span></h3>
<span data-as="p">创建后点击 Group 卡片中的「创建对话任务」，先用一条小范围任务验证：</span>
<ul>
<li>Leader 是否先确认目标，再把子任务交给合适的成员。</li>
<li>每个成员是否使用预期的模型、工作目录和权限。</li>
<li>同一文件是否只有明确的主修改者，评审者是否保持只读。</li>
<li>中间进展、人工确认和最终结果是否都能在同一个任务中查看。</li>
</ul>
<span data-as="p">调整成员、Leader、模型或目录后，新建任务重新验证。删除 Group 不会删除成员 Waker，但会中断依赖该团队的聊天入口；删除前先处理运行中任务并保存需要保留的产物。</span>
<h2 id="停用或删除前检查" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#停用或删除前检查" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>停用或删除前检查</span></h2>
<span data-as="p">停用 Waker 会阻止新的工作，但不会撤销已经完成的修改。删除前依次检查：</span>
<ol>
<li>是否仍有运行中或待确认的对话任务。</li>
<li>是否被自主工作或 WakerFlow 引用。</li>
<li>是否属于 Group，或被 @Waker / IM 聊天使用。</li>
<li>是否有需要保留的产物、记忆或角色配置。</li>
</ol>
<span data-as="p">先暂停外部触发和自动任务，再处理依赖关系，最后停用或删除。</span>
<h2 id="上线检查" class="group relative whitespace-pre-wrap"><div class="absolute -left-9 top-1/2 -translate-y-1/2"><a href="#上线检查" aria-hidden="true" tabindex="-1" class="heading-anchor group/link flex items-center border-0 py-2 opacity-0 focus:outline-0 group-hover:opacity-100">​<div class="flex size-6 items-center justify-center rounded-md bg-white text-stone-400 shadow-sm ring-1 ring-stone-400/30 hover:ring-stone-400/60 dark:bg-stone-950 dark:text-white/50 dark:ring-1 dark:ring-stone-700/25 dark:brightness-[1.35] dark:hover:ring-white/20 dark:hover:brightness-150"><svg aria-hidden="true" fill="currentColor" height="12px" viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 256C0 167.6 71.6 96 160 96h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C98.1 144 48 194.1 48 256s50.1 112 112 112h72c13.3 0 24 10.7 24 24s-10.7 24-24 24H160C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c61.9 0 112-50.1 112-112s-50.1-112-112-112H344c-13.3 0-24-10.7-24-24s10.7-24 24-24h72c88.4 0 160 71.6 160 160zM184 232H392c13.3 0 24 10.7 24 24s-10.7 24-24 24H184c-13.3 0-24-10.7-24-24s10.7-24 24-24z"></path></svg></div></a></div><span>上线检查</span></h2>
<ul>
<li>名称、职责、运行环境和状态与预期一致。</li>
<li>Skills、连接器、知识库和项目均为完成职责所必需。</li>
<li>正常任务、越界任务和高风险确认各验证一次。</li>
<li>普通对话、自主工作、Group 或 IM 入口分别完成过小范围测试。</li>
<li>测试数据没有写入正式目录，截图不包含敏感信息。</li>
</ul></div></div><nav class="mt-32 py-4 flex w-full gap-8 lg:gap-20 bg-neutral-50"><a class="group flex items-center gap-2 rounded-md py-3 transition-colors cursor-pointer" href="/qoderwake/automated-tasks"><div class="min-w-0 flex items-center justify-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left icon inline dark:text-adoc-primary-light shrink-0 text-neutral-450 transition-transform group-hover:-translate-x-0.5" aria-hidden="true" style="width:20px;height:20px;display:inline-block;vertical-align:middle;color:currentColor"><path d="m15 18-6-6 6-6"></path></svg><div class="text-[14px] leading-[22px] text-neutral-750 hidden lg:block text-nowrap">上一页</div></div></a><a class="min-w-0 group flex flex-1 items-center justify-end gap-10 rounded-[18px] py-10 text-left transition-colors cursor-pointer" href="/qoderwake/skills-and-integrations"><div class="min-w-0 flex flex-col items-end"><div class="truncate text-sm font-medium text-neutral-750 max-w-full">Skills 与连接器</div><div class="text-xs truncate text-neutral-550 max-w-full">在能力与资源中心安装 Skills、连接外部服务，并按最小权限分配给 Waker。</div></div><div class="flex items-center justify-end gap-2"><div class="text-[14px] leading-[22px] text-neutral-750 hidden lg:block text-nowrap">下一页</div><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right icon inline dark:text-adoc-primary-light shrink-0 text-neutral-450 transition-transform group-hover:translate-x-0.5" aria-hidden="true" style="width:20px;height:20px;display:inline-block;vertical-align:middle;color:currentColor"><path d="m9 18 6-6-6-6"></path></svg></div></a></nav></article></div></div><div id="content-side-layout" class="content-side-layout pl-[var(--adoc-content-side-gap)] hidden xl:flex self-start sticky shrink-0 xl:flex-col z-[21] h-[calc(100vh-var(--topbar-height)-var(--adoc-content-top-gap))] top-[calc(var(--topbar-height)+var(--adoc-content-top-gap))]"><div id="table-of-contents-layout-wrapper" class="table-of-contents-layout w-full w-[var(--adoc-sidebar-toc-width)] min-w-[var(--adoc-sidebar-toc-width)] h-full sidebar-autohide-scrollbar"><div class="adoc-toc-root z-10 hidden xl:flex flex-col gap-4 w-[var(--adoc-sidebar-toc-width)] min-w-[var(--adoc-sidebar-toc-width)] box-border max-h-full  overflow-y-auto" id="table-of-contents-layout"><div class="flex mt-12 items-center gap-2 min-h-[22px] text-base font-medium leading-[22px] text-neutral-850" aria-label="本页目录"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="h-6 w-6 shrink-0"><path d="M2.44434 12.6665H13.5554" stroke-linecap="round" stroke-linejoin="round"></path><path d="M2.44434 3.3335H13.5554" stroke-linecap="round" stroke-linejoin="round"></path><path d="M2.44434 8H7.33323" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>本页目录</span></div><ul id="table-of-contents-content" class="flex flex-col gap-0 list-none p-0 m-0"><li class="py-3 flex items-start" data-depth="0"><a href="#查看-waker-与-group" class="flex flex-row items-start break-words no-underline outline-none text-sm font-normal leading-10 tracking-normal cursor-pointer transition-colors duration-200 ease-out text-neutral-700 dark:text-adoc-text-secondary "><span class="min-w-0 break-words hover:text-neutral-850">查看 Waker 与 Group</span></a></li><li class="py-3 flex items-start" data-depth="1"><a href="#区分本地与远端-waker" class="flex flex-row items-start break-words no-underline outline-none text-sm font-normal leading-10 tracking-normal cursor-pointer transition-colors duration-200 ease-out text-neutral-650 dark:text-adoc-text-secondary pl-8"><span class="