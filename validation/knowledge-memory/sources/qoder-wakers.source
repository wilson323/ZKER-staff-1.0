n25:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"点击「自定义 Waker」后，先填写角色名称、简介和头像，再选择配置方式。\"}]\n26:[\"$\",\"$L19\",null,{\"level\":\"3\",\"id\":\"使用智能生成\",\"children\":\"使用智能生成\"}]\n27:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"智能生成适合已经能用自然语言说明岗位，但还没有完整角色文件的情况。\"}]\n28:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"在描述中写清服务对象、主要任务、常见输入、交付物、不可执行的操作，以及何时请求人工确认。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"点击生成，等待系统形成职责、工作方式、边界和建议能力。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"逐项检查生成内容。删除宽泛承诺，补充业务范围、目录范围和高风险操作的确认条件。\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"只添加完成工作所需的 Skills 和连接器。需要知识资料时绑定对应知识库，不要把凭据写进角色描述。\"}],\"\\n\"]}]\n29:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://g-adoc.alcasset.com/sync/maas_docs/qoder-cn/master/cn/media/images/qoderwake/upstream-20260902/zh-CN/waker-custom-ai_b7743da1e1ef.png\",\"alt\":\"通过智能生成创建自定义 Waker\"}]}]\n2a:[\"$\",\"span\",null,{\"data-as\":\"p\",\"children\":\"可使用下面的结构组织角色描述：\"}]\n"])</script><script>self.__next_f.push([1,"2b:[\"$\",\"$L56\",null,{\"rawCodeBase64\":\"\",\"children\":[\"$\",\"pre\",null,{\"className\":\"shiki shiki-themes github-light-default dark-plus\",\"style\":{\"backgroundColor\":\"#ffffff\",\"--shiki-dark-bg\":\"#0B0C0E\",\"color\":\"#1f2328\",\"--shiki-dark\":\"#D4D4D4\"},\"language\":\"text\",\"children\":[\"$\",\"code\",null,{\"language\":\"text\",\"children\":[[\"$\",\"span\",null,{\"className\":\"line\",\"children\":[\"$\",\"span\",null,{\"children\":\"服务对象：谁会把任务交给这个 Waker。\"}]}],\"\\n\",[\"$\",\"span\",null,{\"className\":\"line\",\"children\":[\"$\",\"span\",null,{\"children\":\"主要职责：需要稳定完成的 3～5 类任务。\"}]}],\"\\n\",[\"$\",\"span\",null,{\"className\":\"line\",\"children\":[\"$\",\"span\",null,{\"children\":\"输入：会接收哪些目录、文件、消息或业务字段。\"}]}],\"\\n\",[\"$\",\"span\",null,{\"className\":\"line\",\"children\":[\"$\",\"span\",null,{\"children\":\"交付：返回哪些文档、代码、表格、链接或结论。\"}]}],\"\\n\",[\"$\",\"span\",null,{\"class